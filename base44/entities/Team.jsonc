{
  "name": "Team",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Team Name"
    },
    "short_name": {
      "type": "string",
      "title": "Short Name"
    },
    "nickname": {
      "type": "string",
      "title": "Nickname"
    },
    "country": {
      "type": "string",
      "title": "Country"
    },
    "league": {
      "type": "string",
      "title": "League"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo URL (PNG)"
    },
    "crest_url": {
      "type": "string",
      "title": "Club Crest URL"
    },
    "primary_color": {
      "type": "string",
      "title": "Primary Color",
      "default": "#1e3a8a"
    },
    "secondary_color": {
      "type": "string",
      "title": "Secondary Color",
      "default": "#ffffff"
    },
    "coach": {
      "type": "string",
      "title": "Head Coach"
    },
    "assistant_coach": {
      "type": "string",
      "title": "Assistant Coach"
    },
    "captain": {
      "type": "string",
      "title": "Captain"
    },
    "formation": {
      "type": "string",
      "title": "Formation",
      "default": "4-3-3"
    }
  },
  "required": [
    "name",
    "short_name"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}