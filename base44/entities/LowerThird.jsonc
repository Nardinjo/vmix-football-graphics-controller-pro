      "type": "string",
      "title": "Title Line"
    },
    "subtitle": {
      "type": "string",
      "title": "Subtitle Line"
    },
    "team_id": {
      "type": "string",
      "title": "Team ID"
    },
    "color": {
      "type": "string",
      "title": "Accent Color",
      "default": "#3b82f6"
    }
  },
  "required": [
